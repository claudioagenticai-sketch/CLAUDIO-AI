{
  "name": "claudio-local",
  "version": "0.2.0",
  "description": "Claudio Local: a private agent workspace and creator studio that runs on your own machine and connects to Claudio (useclaudio.xyz). Bring your own keys.",
  "private": true,
  "license": "MIT",
  "homepage": "https://useclaudio.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudio-onchain/claudio-local.git"
  },
  "bugs": {
    "url": "https://github.com/claudio-onchain/claudio-local/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "claudio-local": "bin/claudio-local"
  },
  "scripts": {
    "build": "tsc -p dashboard/tsconfig.json --noEmit && vite build --config dashboard/vite.config.ts",
    "start": "node server/index.js",
    "dev": "vite --config dashboard/vite.config.ts",
    "check": "tsc -p dashboard/tsconfig.json --noEmit && for f in server/*.js server/lib/*.js bin/claudio-local; do node --check \"$f\" || exit 1; done",
    "app:mac": "bash native/build-app.sh"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@useclaudio/media": "file:../packages/media",
    "@useclaudio/sdk": "file:../packages/sdk",
    "@useclaudio/social": "file:../packages/social",
    "bs58": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
