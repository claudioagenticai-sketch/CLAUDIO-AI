# Claudio — https://useclaudio.xyz
# The board runs without keys (public RPCs + a clearly-labelled simulator). The "Claudio" block below is what production needs.
PORT=5000
DATABASE_URL=

# ── Claudio ──
# Public site: COMING_SOON=false opens it; anything else shows only the teaser. PREVIEW_KEY (16+ chars) unlocks one browser
# at /preview?key=… (/preview?off=1 clears it).
COMING_SOON=
PREVIEW_KEY=
PUBLIC_BASE_URL=https://useclaudio.xyz
# Admin: wallets that see the Admin link (comma-separated Solana addresses) + the password step.
ADMIN_WALLETS=
ADMIN_PASSWORD=
# Free OpenRouter models only (Claudio, resident + hosted agents) and a daily call budget.
OPENROUTER_API_KEY=
OPENROUTER_DAILY_BUDGET=
# Collector bot (pushes fee payouts) and the master key that encrypts hosted-agent escrow wallets.
COLLECTOR_KEY=
VAULT_MASTER_KEY=
# Claudio's pump.fun Address Lookup Table.
PUMP_LUT_ADDRESS=
# Ops alerts (collector failures, low balances).
ALERT_WEBHOOK_URL=

# RPCs: each *_RPC_URL / *_WS_URL accepts a comma-separated list, tried before the built-in, live-tested public
# endpoints (docs/research/rpc.md). Only set a *_WS_URL together with a private *_RPC_URL: with a socket the poller
# queries once per block.
# Robinhood Chain (4663). Public RPC is rate-limited; use Alchemy/QuickNode for prod.
HOOD_RPC_URL=
# Launches only (plans, simulations, splitter reads); the feed and trading keep using the list above.
HOOD_LAUNCH_RPC_URL=
HOOD_WS_URL=
# BNB Chain
BSC_RPC_URL=
BSC_WS_URL=
# Solana (SOLANA_RPC_URL also works)
SOL_RPC_URL=
SOLANA_WS_URL=
HELIUS_API_KEY=
# Live trades while a coin page is open (server/trades/live). PumpPortal first (metered: 0.01 SOL / 10k trade events,
# one shared socket); the public key only shows the metering wallet's SOL balance in status. The data API never needs
# the wallet's private key — Claudio doesn't read PUMPPORTAL_WALLET_PRIVATE_KEY.
PUMPPORTAL_API_KEY=

# GMGN OpenAPI (server/insights — read endpoints only, one adaptive queue, memory cache, never the DB). Only the key is
# needed; the rest are tuning knobs. GMGN bans for 5 s per request sent during a 429 cooldown (up to 5 min), so keep the
# rate low: the gateway pauses on 429 until X-RateLimit-Reset and halves its rate, then creeps back (+0.1/s per quiet min).
GMGN_API_KEY=
# Start / max / burst request rate (req/s) and the weight budget (GMGN weights: holders 5, rank 3, kline 2, info 1 …).
GMGN_RPS=2
GMGN_MAX_RPS=2.5
GMGN_BURST=3
GMGN_WEIGHT_RATE=2
GMGN_WEIGHT_BURST=5
GMGN_MAX_QUEUE=120
# Chains whose GMGN Trenches lists are merged into the board (comma-separated; sol|hood|bsc|base).
GMGN_TRENCHES_CHAINS=sol
PUMPPORTAL_WALLET_PUBLIC_KEY=
# Fallback when PumpPortal has no key / is metered out / banned: Alchemy Solana WS (logsSubscribe per curve / pool).
# Either the full URL or just the key (→ wss://solana-mainnet.g.alchemy.com/v2/<key>). Never Helius (SOL_RPC_URL).
ALCHEMY_SOL_WS_URL=
ALCHEMY_API_KEY=
# LIVE_TRADES_MAX=60            concurrent watched tokens (least-recently-viewed evicted; pins never)
# LIVE_TRADES_GRACE_MS=60000    keep a token live this long after its last viewer leaves

# Metadata pinning (pump.fun's IPFS endpoint is dead)
PINATA_JWT=

# 70/30 fee split. PLATFORM_TREASURY_SOL MUST equal the platform wallet in shared/platform.ts
# (4Eh38JobinLouigdGceUeMLGJR3B4T9s557xJHdW8n9P) — the server refuses to launch otherwise. EVM chains are coming soon.
PLATFORM_TREASURY_SOL=4Eh38JobinLouigdGceUeMLGJR3B4T9s557xJHdW8n9P
PLATFORM_TREASURY_EVM=
# Contract addresses per chain (optional when a deployments file is present, see CLAUDIO_DEPLOYMENTS_DIR).
FEE_SPLITTER_FACTORY_HOOD=
FEE_SPLITTER_FACTORY_BSC=
# Creator share split between the launcher and several social accounts (ShareSplitterFactory).
SHARE_SPLITTER_FACTORY_HOOD=

# Simulator: "auto" = only for chains without a live feed, "on" = always, "off" = never
SIMULATOR=auto

# ── Social fee accounts ──
# Server key that signs claim approvals (its ADDRESS is the factory's attestor). Fresh key, used for nothing else.
SOCIAL_ATTESTOR_KEY=
SOCIAL_VAULT_FACTORY_HOOD=
# Handle lookups at launch time
X_BEARER_TOKEN=
NEYNAR_API_KEY=
GITHUB_TOKEN=
# Sign-in: Clerk and/or Auth0 (VITE_* are baked into the client at build time)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ── Testnet ──
# CLAUDIO_NETWORK=testnet + VITE_CLAUDIO_NETWORK=testnet switch every chain to its test network. Chain-specific settings are
# then read ONLY from *_TESTNET names (HOOD_RPC_URL_TESTNET, FEE_SPLITTER_FACTORY_HOOD_TESTNET, PLATFORM_TREASURY_EVM_TESTNET…).
CLAUDIO_NETWORK=
VITE_CLAUDIO_NETWORK=
# Directory holding <chainId>.json deployment records (optional).
CLAUDIO_DEPLOYMENTS_DIR=
SOCIAL_ATTESTOR_KEY_TESTNET=
RELAYER_KEY_TESTNET=
